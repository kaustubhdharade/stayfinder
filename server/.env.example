# ==============================================================================
# StayFinder Backend Environment Configuration Template
# Copy this file to .env and adjust variables for your local or production environment.
# ==============================================================================

# Server Runtime
PORT=5001
NODE_ENV=development
API_PREFIX=/api

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stayfinder?schema=public"

# Future Security & Authentication (Placeholders - will be configured in Phase 1)
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
